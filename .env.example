# Environment Variables for SQL Randomized Test Suite (AWS Lightsail + Docker PostgreSQL)
# Copy this file to .env on the server: cp .env.example .env

# Admin Dashboard Password
ADMIN_PASSWORD=change_this_admin_password

# PostgreSQL 16 Database Configuration
POSTGRES_USER=sqlstudy
POSTGRES_PASSWORD=sqlstudy_secret
POSTGRES_DB=sql_study
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
